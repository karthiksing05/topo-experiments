{
  "_comment": [
    "Shared config for both experiment scripts in src/fashion_mnist_forgetting/:",
    "  fmnist_forgetting.py  — full pretrain + finetune forgetting experiment",
    "  train_fmnist_topo.py  — pretrain-only run (uses 'epochs' key)",
    "",
    "Top-level keys can be overridden via CLI (e.g. --pretrain-epochs 30).",
    "Per-layer keys (topo_scale, factor_h, …) must be edited here.",
    "noise_target_class: 0=T-shirt, 1=Trouser, 2=Pullover, 3=Dress, 4=Coat,",
    "                    5=Sandal, 6=Shirt, 7=Sneaker, 8=Bag, 9=AnkleBoot",
    "ft_source_class:    source class whose real images are used as finetune stimuli",
    "                    (relabeled as noise_target_class). null = pure-noise mode."
  ],

  "data_dir":           null,
  "output_dir":         null,
  "hidden_size":        256,

  "epochs":             20,
  "pretrain_epochs":    20,
  "finetune_epochs":    30,

  "batch_size":         128,
  "lr":                 0.0005,
  "finetune_lr":        0.0005,
  "device":             "cuda:0",
  "print_freq":         5,

  "noise_target_class": 0,
  "noise_samples":      2000,
  "ft_source_class":    9,

  "auxk_k":             16,
  "auxk_k_aux":         64,
  "auxk_k_pooled":      1,
  "auxk_k_aux_pooled":  4,

  "resume_topo":        null,
  "resume_topo_only":   null,
  "resume_base":        null,

  "regionlock_threshold": 0.0625,
  "ewc_lambda":         400.0,
  "ewc_n_samples":      2048,
  "replay_capacity":    500,
  "replay_batch_size":  32,
  "layers": {
    "fc1": {
      "topo_scale":     10.0,
      "factor_h":        4.0,
      "factor_w":        4.0,
      "lambda_kl":       0.1,
      "lambda_entropy":  5.0,
      "lambda_sim":       0.5,
      "temperature":     1.0,
      "auxk_alpha":      0.5,
      "dead_threshold":  20
    }
  }
}
