{
    "_comment": "slow_converge: lower learning rate (5e-4), more epochs (40), very slow death (high sustained_steps). Treats topographic self-organisation as a slow annealing process. Neurons survive longer to accumulate evidence, and weight updates are smaller so structure drifts less per step. Combines with high beta for stable patch membership.",

    "training": {
        "epochs": 40,
        "batch_size": 64,
        "lr": 0.0005,
        "lambda_cross": 0.01
    },

    "layer1": {
        "in_features": 784,
        "out_features": 256,
        "grid_size": 4,
        "warmup_steps": 200,
        "expansion_threshold": 0.10,
        "death_threshold": 0.01,
        "death_sustained_steps": 500,
        "expansion_radius": 1,
        "residual_weight": 0.5,
        "beta": 0.88,
        "lambda_intra": 0.1
    },

    "layer2": {
        "in_features": 256,
        "out_features": 128,
        "grid_size": 3,
        "warmup_steps": 300,
        "expansion_threshold": 0.10,
        "death_threshold": 0.01,
        "death_sustained_steps": 600,
        "expansion_radius": 1,
        "residual_weight": 0.5,
        "beta": 0.88,
        "lambda_intra": 0.1
    },

    "viz": {
        "viz_every": 5,
        "viz_dir": "outputs/toposeed/viz_mlp_slow_converge"
    }
}
