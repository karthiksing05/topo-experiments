{
    "_comment": "strong_topo: maximum smoothness pressure. Very high lambda_intra forces neighboring neurons to share similar weights. Very high lambda_cross enforces spatial coherence across layers. High beta keeps patch memberships stable (slow drift). Tests whether strong regularization alone produces clean topographic organisation without structural changes.",

    "training": {
        "epochs": 20,
        "batch_size": 64,
        "lr": 0.001,
        "lambda_cross": 0.03
    },

    "layer1": {
        "in_features": 784,
        "out_features": 256,
        "grid_size": 4,
        "warmup_steps": 200,
        "expansion_threshold": 0.12,
        "death_threshold": 0.02,
        "death_sustained_steps": 150,
        "expansion_radius": 1,
        "residual_weight": 0.5,
        "beta": 0.92,
        "lambda_intra": 0.25
    },

    "layer2": {
        "in_features": 256,
        "out_features": 128,
        "grid_size": 3,
        "warmup_steps": 300,
        "expansion_threshold": 0.12,
        "death_threshold": 0.02,
        "death_sustained_steps": 200,
        "expansion_radius": 1,
        "residual_weight": 0.5,
        "beta": 0.92,
        "lambda_intra": 0.25
    },

    "viz": {
        "viz_every": 5,
        "viz_dir": "outputs/toposeed/viz_mlp_strong_topo"
    }
}
