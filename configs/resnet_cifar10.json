{
    "_comment": "Config for src/resnet_cifar10.py. Pass with --config configs/resnet_cifar10.json",

    "training": {
        "epochs": 50,
        "batch_size": 128,
        "lr": 0.1,
        "lambda_reg": 0.005
    },

    "topo_defaults": {
        "expansion_threshold": 0.15,
        "death_threshold": 0.02,
        "death_sustained_steps": 400,
        "expansion_radius": 1,
        "residual_weight": 0.5,
        "beta": 0.7,
        "lambda_intra": 0.01,
        "base_warmup_steps": 500,
        "warmup_depth_increment": 200
    },

    "viz": {
        "viz_every": 10,
        "viz_dir": "outputs/toposeed/viz_resnet"
    }
}
