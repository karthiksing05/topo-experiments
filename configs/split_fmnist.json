{
  "_comment": [
    "Config for the Split-FashionMNIST continual learning experiment:",
    "  src/fashion_mnist_forgetting/split_fmnist_forgetting.py",
    "",
    "Five sequential binary tasks (class-incremental, single 10-way head):",
    "  Task 0: T-shirt  (0)  vs Trouser    (1)",
    "  Task 1: Pullover (2)  vs Dress      (3)",
    "  Task 2: Coat     (4)  vs Sandal     (5)",
    "  Task 3: Shirt    (6)  vs Sneaker    (7)",
    "  Task 4: Bag      (8)  vs AnkleBoot  (9)",
    "",
    "Top-level keys are overridable via CLI (e.g. --task-epochs 15).",
    "Per-layer keys (topo_scale, factor_h, …) must be edited here directly.",
    "The optimizer is NOT reset between tasks (standard CL protocol)."
  ],

  "data_dir":    null,
  "output_dir":  null,
  "hidden_size": 256,

  "task_epochs": 10,

  "batch_size":  128,
  "lr":          0.0005,
  "device":      "cuda:0",
  "print_freq":  2,

  "auxk_k":             16,
  "auxk_k_aux":         16,
  "auxk_k_pooled":      1,
  "auxk_k_aux_pooled":  1,

  "regionlock_threshold": 0.0625,
  "ewc_lambda":         400.0,
  "ewc_n_samples":      2048,
  "replay_capacity":    500,
  "replay_batch_size":  32,
  "layers": {
    "fc1": {
      "topo_scale":     10.0,
      "factor_h":        4.0,
      "factor_w":        4.0,
      "lambda_kl":       0.1,
      "lambda_entropy":  100.0,
      "lambda_sim":      0.0,
      "temperature":     1.0,
      "auxk_alpha":      5.0,
      "dead_threshold":  8
    }
  }
}
