{
  "_comment": [
    "Config for src/topo_quant/train_gpt2_topo_quant.py",
    "",
    "Trains GPT-2 small (openai-community/gpt2 architecture) on FineWeb-edu.",
    "Two variants: 'baseline' (CE only) and 'topo_quant' (CE + SoftTopoQuantLoss).",
    "",
    "The quantised reference model is TheBloke/gpt2-GPTQ (4-bit GPTQ).",
    "Our topo_quant variant aims to produce weight distributions that match",
    "4-bit quantisation levels more naturally than the baseline.",
    "",
    "Suggested slurm overrides:",
    "  --export=VARIANT=baseline    runs only the baseline",
    "  --export=VARIANT=topo_quant  runs only the topo-quant variant",
    "  --export=MAX_STEPS=50000     shorter run for debugging"
  ],

  "device":      "cuda:0",
  "compile":     true,

  "vocab_size":  50304,
  "n_layer":     12,
  "n_head":      12,
  "n_embd":      768,
  "block_size":  1024,
  "dropout":     0.0,

  "batch_size":    8,
  "max_steps":     100000,
  "warmup_steps":  2000,
  "max_lr":        6e-4,
  "min_lr":        6e-5,
  "beta1":         0.9,
  "beta2":         0.95,
  "weight_decay":  0.1,
  "grad_clip":     1.0,

  "log_interval":  100,
  "save_interval": 2000,

  "num_bits":           4,
  "tau":                1.0,
  "soft_initial_temp":  10.0,
  "soft_final_temp":    0.1,
  "anneal_fraction":    0.5,
  "anneal_schedule":    "cosine"
}
