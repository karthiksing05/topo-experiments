{
  "_comment": [
    "ResNet-18 + TopoLoss + entropy-sparsity penalty on ImageNet.",
    "Three models are trained: topo (TopoLoss+entropy), topo_only (TopoLoss only), baseline (CE only).",
    "Training schedule follows the original ResNet paper:",
    "  SGD, momentum=0.9, weight_decay=1e-4, lr=0.1 -> /10 at epochs 30/60/80, 90 total epochs.",
    "",
    "default_layer_cfg  : applied to every residual-block conv not listed in 'layers'.",
    "layers             : per-layer overrides keyed by module name (e.g. 'layer3.0.conv1').",
    "  topo_scale       : multiplicative weight on the LaplacianPyramid loss for this conv.",
    "  factor_h/w       : downsampling factor on the cortical-sheet height/width before entropy.",
    "  lambda_entropy   : weight on the per-sample entropy loss  (0 = disable).",
    "  temperature      : softmax temperature used for entropy computation.",
    "",
    "include_downsample : if true, also attach TopoLoss+entropy to the 1x1 downsample convs.",
    "null paths resolve to project-root defaults at runtime."
  ],

  "data_dir":    null,
  "output_dir":  null,
  "num_classes": 1000,

  "epochs":        90,
  "batch_size":    256,
  "lr":            0.1,
  "momentum":      0.9,
  "weight_decay":  1e-4,
  "lr_milestones": [30, 60, 80],
  "lr_gamma":      0.1,

  "device":       "cuda:0",
  "num_workers":  8,
  "print_freq":   200,
  "save_freq":    5,

  "resume_topo":      null,
  "resume_topo_only": null,
  "resume_base":      null,

  "include_downsample": false,

  "default_layer_cfg": {
    "topo_scale":    10.0,
    "factor_h":      2.0,
    "factor_w":      2.0,
    "lambda_entropy": 1.0,
    "temperature":   1.0
  },

  "layers": {
    "layer1.0.conv1": { "topo_scale": 10.0,  "factor_h": 4.0, "factor_w": 4.0, "lambda_entropy": 1.0, "temperature": 1.0 },
    "layer1.0.conv2": { "topo_scale": 10.0,  "factor_h": 4.0, "factor_w": 4.0, "lambda_entropy": 1.0, "temperature": 1.0 },
    "layer1.1.conv1": { "topo_scale": 10.0,  "factor_h": 4.0, "factor_w": 4.0, "lambda_entropy": 1.0, "temperature": 1.0 },
    "layer1.1.conv2": { "topo_scale": 10.0,  "factor_h": 4.0, "factor_w": 4.0, "lambda_entropy": 1.0, "temperature": 1.0 },

    "layer2.0.conv1": { "topo_scale": 10.0,  "factor_h": 4.0, "factor_w": 4.0, "lambda_entropy": 1.0, "temperature": 1.0 },
    "layer2.0.conv2": { "topo_scale": 10.0,  "factor_h": 4.0, "factor_w": 4.0, "lambda_entropy": 1.0, "temperature": 1.0 },
    "layer2.1.conv1": { "topo_scale": 10.0,  "factor_h": 4.0, "factor_w": 4.0, "lambda_entropy": 1.0, "temperature": 1.0 },
    "layer2.1.conv2": { "topo_scale": 10.0,  "factor_h": 4.0, "factor_w": 4.0, "lambda_entropy": 1.0, "temperature": 1.0 },

    "layer3.0.conv1": { "topo_scale": 10.0,  "factor_h": 4.0, "factor_w": 4.0, "lambda_entropy": 1.0, "temperature": 1.0 },
    "layer3.0.conv2": { "topo_scale": 10.0,  "factor_h": 4.0, "factor_w": 4.0, "lambda_entropy": 1.0, "temperature": 1.0 },
    "layer3.1.conv1": { "topo_scale": 10.0,  "factor_h": 4.0, "factor_w": 4.0, "lambda_entropy": 1.0, "temperature": 1.0 },
    "layer3.1.conv2": { "topo_scale": 10.0,  "factor_h": 4.0, "factor_w": 4.0, "lambda_entropy": 1.0, "temperature": 1.0 },

    "layer4.0.conv1": { "topo_scale": 10.0,  "factor_h": 4.0, "factor_w": 4.0, "lambda_entropy": 1.0, "temperature": 1.0 },
    "layer4.0.conv2": { "topo_scale": 10.0,  "factor_h": 4.0, "factor_w": 4.0, "lambda_entropy": 1.0, "temperature": 1.0 },
    "layer4.1.conv1": { "topo_scale": 10.0,  "factor_h": 4.0, "factor_w": 4.0, "lambda_entropy": 1.0, "temperature": 1.0 },
    "layer4.1.conv2": { "topo_scale": 10.0,  "factor_h": 4.0, "factor_w": 4.0, "lambda_entropy": 1.0, "temperature": 1.0 }
  }
}
